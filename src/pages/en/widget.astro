---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/fire-calculator/" title="FIRE calculator with the 59½ rules" width="100%" height="1300" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the FIRE calculator with the 59½ rules on your site, free" description="Bloggers, forums and personal finance teachers can embed the FIRE calculator that counts tax, health premiums and the 59½ access rules with one iframe line. No cookie, no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the FIRE calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the IRS publishes new brackets or a new monthly rate, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the calculator visible, do not alter the frame, and do not place it next to an offer to sell accounts, funds or advice. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>FIRE calculator with tax, health premiums and access before 59½</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/fire-calculator/" title="FIRE calculator with the 59½ rules" width="100%" height="1300" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
